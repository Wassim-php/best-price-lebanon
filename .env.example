# ============================================
# DJANGO & SECURITY
# ============================================
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False

# For production: ALLOWED_HOSTS=your-app.railway.app,your-domain.com
# For development: localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1

# For production: https://awfarlak-react.vercel.app
# For development: http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URLS=https://awfarlak-react.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# ============================================
# DATABASE (PostgreSQL)
# ============================================
# Railway will auto-provide DATABASE_URL
# For local development:
POSTGRES_NAME=lebanon_prices
POSTGRES_USER=awfarlak
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ============================================
# REDIS (for Celery)
# ============================================
# Railway will auto-provide REDIS_URL
# For local development:
REDIS_HOST=redis
REDIS_PORT=6379

# ============================================
# API KEYS & TOKENS
# ============================================
GEMINI_API_KEY=replace-with-your-gemini-api-key
GOOGLE_OAUTH_CLIENT_ID=replace-with-your-google-client-id.apps.googleusercontent.com
ISHTARI_API_TOKEN=replace-with-ishtari-bearer-token

# ============================================
# SSL/SECURITY (uncomment for production)
# ============================================
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
